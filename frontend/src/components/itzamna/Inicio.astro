---
import { t } from 'i18next'
---

<section class='bg-black text-white py-16'>
  <div class='container mx-auto px-4'>
    <p class='uppercase tracking-[0.2em] text-sm text-gray-300'>
      {t('itzamna.by')}
    </p>
    <h1 class='text-3xl md:text-5xl font-bold mt-2'>{t('itzamna.title')}</h1>
    <p class='text-lg md:text-xl mt-3 text-gray-200'>
      {t('itzamna.description')}
    </p>

    <div class='mt-8 bg-white/10 p-6 rounded-lg border border-white/20'>
      <h2 class='text-xl md:text-2xl font-semibold mb-3'>
        {t('itzamna.subtitle')}
      </h2>
      <p class='leading-relaxed'>{t('itzamna.text_1')}</p>
    </div>

    <div class='mt-8 bg-white/10 p-6 rounded-lg border border-white/20'>
      <h3 class='text-xl md:text-2xl font-semibold mb-3'>
        {t('itzamna.what_is')}
      </h3>
      <p class='leading-relaxed mb-3'>{t('itzamna.text_2')}</p>
      <p class='leading-relaxed mb-4'>{t('itzamna.text_3')}</p>
      <ul class='list-disc pl-6 space-y-1'>
        <li>{t('itzamna.proyecto_1') || t('itzamna.project_1')}</li>
        <li>{t('itzamna.proyecto_2') || t('itzamna.project_2')}</li>
        <li>{t('itzamna.proyecto_3') || t('itzamna.project_3')}</li>
        <li>{t('itzamna.proyecto_4') || t('itzamna.project_4')}</li>
        <li>{t('itzamna.proyecto_5') || t('itzamna.project_5')}</li>
      </ul>
      <p class='leading-relaxed mt-4'>{t('itzamna.text_4')}</p>
    </div>
  </div>
</section>
