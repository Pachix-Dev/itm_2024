---
import { t } from 'i18next'
---

<section class='bg-gray-100 py-16'>
  <div class='container mx-auto px-4'>
    <h2 class='text-2xl md:text-4xl font-bold mb-6'>{t('itzamna.objetivo')}</h2>
    <p class='text-base md:text-lg leading-relaxed mb-6'>
      {t('itzamna.objetivo_desc')}
    </p>

    <ul class='list-disc pl-6 space-y-3 text-base md:text-lg'>
      <li>{t('itzamna.objetivo_1')}</li>
      <li>{t('itzamna.objetivo_2')}</li>
      <li>{t('itzamna.objetivo_3')}</li>
      <li>{t('itzamna.objetivo_4')}</li>
      <li>{t('itzamna.objetivo_5')}</li>
      <li>{t('itzamna.objetivo_6')}</li>
      <li>{t('itzamna.objetivo_7')}</li>
      <li>{t('itzamna.objetivo_8')}</li>
      <li>{t('itzamna.objetivo_9')}</li>
    </ul>

    <h3 class='text-2xl md:text-3xl font-bold mt-10 mb-4'>
      {t('itzamna.who')}
    </h3>
    <ul class='list-disc pl-6 space-y-2 text-base md:text-lg'>
      <li>{t('itzamna.who_1')}</li>
      <li>{t('itzamna.who_2')}</li>
      <li>{t('itzamna.who_3')}</li>
      <li>{t('itzamna.who_4')}</li>
      <li>{t('itzamna.who_5')}</li>
    </ul>
  </div>
</section>
