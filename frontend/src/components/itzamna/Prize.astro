---
import { t } from 'i18next'
---

<section class='bg-black text-white py-16'>
  <div class='container mx-auto px-4'>
    <h2 class='text-2xl md:text-4xl font-bold mb-6'>{t('itzamna.prize')}</h2>

    <ul class='list-disc pl-6 space-y-2 text-base md:text-lg'>
      <li>{t('itzamna.prize_1')}</li>
      <li>{t('itzamna.prize_2')}</li>
      <li>{t('itzamna.prize_3')}</li>
      <li>{t('itzamna.prize_3_1')}</li>
      <li>{t('itzamna.prize_3_2')}</li>
      <li>{t('itzamna.prize_3_3')}</li>
      <li>{t('itzamna.prize_4')}</li>
    </ul>

    <div class='mt-8 p-5 rounded-lg border border-white/20 bg-white/10'>
      <h3 class='font-semibold text-lg mb-2'>{t('itzamna.Awards')}</h3>
      <p>{t('itzamna.awards_1')}</p>
      <p class='mt-1'>{t('itzamna.awards_2')}</p>
      <p class='mt-2'>{t('itzamna.awards_desc')}</p>
    </div>

    <div class='mt-4 p-5 rounded-lg border border-white/20 bg-white/10'>
      <h3 class='font-semibold text-lg mb-2'>
        {t('itzamna.industry_property')}
      </h3>
      <p>{t('itzamna.industry_property_desc')}</p>
      <p class='mt-2'>{t('itzamna.industry_property_desc_2')}</p>
      <p class='mt-2 font-semibold'>
        {t('itzamna.industry_property_important')}
      </p>
    </div>
  </div>
</section>
