---
import { t } from 'i18next'
---

<section class='bg-white py-16'>
  <div class='container mx-auto px-4'>
    <h2 class='text-2xl md:text-4xl font-bold mb-6'>
      {t('itzamna.how_to_participate')}
    </h2>

    <div class='grid gap-4'>
      <div class='p-5 rounded-lg border border-gray-200'>
        <h3 class='font-semibold text-lg'>{t('itzamna.step_1')}</h3>
        <p class='mt-2'>{t('itzamna.desc_1')}</p>
      </div>

      <div class='p-5 rounded-lg border border-gray-200'>
        <h3 class='font-semibold text-lg'>{t('itzamna.step_2')}</h3>
      </div>

      <div class='p-5 rounded-lg border border-gray-200'>
        <h3 class='font-semibold text-lg'>{t('itzamna.step_3')}</h3>
        <p class='mt-2'>{t('itzamna.desc_3')}</p>
      </div>

      <div class='p-5 rounded-lg border border-gray-200'>
        <h3 class='font-semibold text-lg'>{t('itzamna.step_4')}</h3>
        <p class='mt-2'>{t('itzamna.desc_4')}</p>
      </div>
    </div>

    <p class='mt-8 p-4 rounded-lg bg-red-50 text-red-700 border border-red-200'>
      {t('itzamna.importante')}
    </p>
  </div>
</section>
